{
  "name": "startora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n client,server \"pnpm dev:client\" \"pnpm dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "prebuild": "node scripts/generate-icon-manifest.mjs",
    "predev": "node scripts/generate-icon-manifest.mjs",
    "build": "vite build && tsc -b --force",
    "build:demo": "node scripts/generate-icon-manifest.mjs && tsc -b tsconfig.app.json --force && vite build --mode demo --outDir dist/demo",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node dist/server/server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "better-sqlite3": "^12.10.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-stately/utils": "^3.12.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@untitledui/icons": "^0.0.22",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "i18next": "^26.3.6",
    "input-otp": "^1.4.2",
    "jsdom": "^27.0.0",
    "oxlint": "^1.71.0",
    "react": "^19.2.7",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-router": "^8.3.0",
    "supertest": "^7.1.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-imagetools": "^10.0.1",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  }
}
