# Copy this file to .env.dev before running `pnpm start-server`.
# The server entrypoint currently loads `.env.dev`.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=startora
DB_USER=postgres
DB_PASSWORD=

# JWT
# Required in practice. Use JWT_SECRET for both tokens, or set
# ACCESS_TOKEN_SECRET and REFRESH_TOKEN_SECRET separately.
JWT_SECRET=replace-me
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
